NEXT_PUBLIC_APP_NAME=Fusion Space

# 本地开发（默认，无需 Docker）：数据库文件在项目根目录 dev.db
DATABASE_URL="file:./dev.db"

# 公网 Docker：数据库与上传文件建议同一持久卷，例如 Dockerfile 默认 UPLOAD_DIR=/app/data/uploads
# UPLOAD_DIR=/app/data/uploads

# 若使用 Docker 中的 PostgreSQL：docker compose up -d 后改用下方连接串，
# 并把 prisma/schema.prisma 的 datasource provider 改为 postgresql，再自行用 prisma migrate diff 生成迁移。
# DATABASE_URL="postgresql://fusion:fusion@localhost:5432/fusion?schema=public"

# ========== LLM（二选一或组合）==========
GEMINI_API_KEY=

# ① 原生 Gemini 代理（路径 /v1beta/models/{model}:generateContent）：
# 根地址需包含卖家要求的路径前缀。例（UniAPI）：https://api.uniapi.io/gemini
# GEMINI_RELAY_BASE_URL=https://api.uniapi.io/gemini
# GEMINI_RELAY_AUTH=goog-api-key
# （Bearer 可省略 GEMINI_RELAY_AUTH；也可用 x-api-key、GEMINI_RELAY_KEY_QUERY=1）
# GEMINI_RELAY_TIMEOUT_MS=900000

# ② OpenAI 兼容中转（Chat Completions，地址通常含 /v1）：
# GEMINI_OPENAI_BASE_URL=https://example.com/v1

# ③ 官方 Google AI Studio（密钥多为 AIza 开头）：只配 GEMINI_API_KEY，不要配 RELAY / OPENAI_BASE_URL。
# 强制走官方 SDK：GEMINI_NATIVE=1

GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# 兼容：OpenAI / 智谱等（OpenAI Chat Completions 协议）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4.1-mini
# 图片 OCR（硅基流动等多模态）：与平台模型 id 一致，如 Qwen/Qwen2-VL-7B-Instruct
# OPENAI_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# OPENAI_TIMEOUT_MS=900000
# OPENAI_LONG_TIMEOUT_MS=1800000
# AI_REQUIREMENT_MAX_CHARS=14000

# 站内邮件（任选其一；都不配则只写库、不实际发信）
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Resend：https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM="Fusion <onboarding@resend.dev>"
# 或 SMTP：
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
