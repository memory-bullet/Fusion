generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  name              String
  creditScore       Int             @default(100)
  accumulatedPoints Int             @default(0)
  createdAt         DateTime        @default(now())
  memberships       ProjectMember[]
  assignedTasks     Task[]
  logs              ActionLog[]
  uploadedFiles     ProjectFile[]
}

model Project {
  id                String          @id @default(cuid())
  title             String
  inviteCode        String          @unique
  contextSummary    String          @default("No context yet")
  keyDeliverables   String?
  status            String          @default("ACTIVE")
  deadline          DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  members           ProjectMember[]
  tasks             Task[]
  logs              ActionLog[]
  files             ProjectFile[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  assigneeId     String?
  title          String
  sourceLabel    String?
  workloadPoints Int
  status         String   @default("UNASSIGNED")
  deadline       DateTime
  warningLevel   String   @default("NORMAL")
  isReallocated  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id])
}

model ActionLog {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  actionType  String
  description String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploaderId   String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
}
