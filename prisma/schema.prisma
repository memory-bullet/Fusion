generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String?              @unique
  passwordHash      String?
  creditScore       Int                  @default(100)
  accumulatedPoints Int                  @default(0)
  createdAt         DateTime             @default(now())
  memberships       ProjectMember[]
  assignedTasks     Task[]
  logs              ActionLog[]
  authoredDocuments ProjectDocument[]
  chatMessages      ProjectChatMessage[]
  notifications     UserNotification[]
  emailOutbox       EmailOutbox[]
  taskNotes         TaskNote[]
}

model Project {
  id                   String               @id @default(cuid())
  title                String
  inviteCode           String               @unique
  contextSummary       String               @default("No context yet")
  keyDeliverables      String?
  assignmentMilestones String?
  progressDigest       String?
  progressDigestAt     DateTime?
  status               String               @default("ACTIVE")
  deadline             DateTime
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  members              ProjectMember[]
  tasks                Task[]
  logs                 ActionLog[]
  documents            ProjectDocument[]
  chatMessages         ProjectChatMessage[]
  notifications        UserNotification[]
  presets              MemberPreset[]
}

/// 项目内共享 AI 对话（全员可见同一会话历史）
model ProjectChatMessage {
  id        String   @id @default(cuid())
  projectId String
  /// 仅 role=USER 时有值；ASSISTANT 为空
  userId    String?
  role      String
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model ProjectDocument {
  id               String   @id @default(cuid())
  projectId        String
  authorId         String
  title            String
  content          String   @default("")
  /// 上传者对作品的文字说明（作业描述、版本说明等）
  description      String   @default("")
  /// 原始文件名（有则表示磁盘上有对应上传文件）
  originalFileName String?
  mimeType         String?
  fileSize         Int?
  /// 相对 uploads 根目录的路径，如 projectId/docId/name.ext
  storageKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  role         String   @default("MEMBER")
  joinedStatus String   @default("ACTIVATED")
  joinedAt     DateTime @default(now())
  displayName  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model MemberPreset {
  id          String   @id @default(cuid())
  projectId   String
  presetName  String
  activated   Boolean  @default(false)
  activatedBy String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id                      String    @id @default(cuid())
  projectId               String
  assigneeId              String?
  title                   String
  sourceLabel             String?
  workloadPoints          Int
  status                  String    @default("UNASSIGNED")
  deadline                DateTime
  warningLevel            String    @default("NORMAL")
  isReallocated           Boolean   @default(false)
  /// 最后通牒：NONE | WARN_3D（≤72h）| RED_24H（≤24h），全员可见
  ultimatumLevel          String    @default("NONE")
  ultimatumWarnNotifiedAt DateTime?
  ultimatumRedNotifiedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?      @relation(fields: [assigneeId], references: [id])
  notes    TaskNote[]
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model ActionLog {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  actionType  String
  description String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 站内信：登录用户收件箱，可关联项目与外链
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  kind      String
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  emailDeliveries EmailOutbox[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// 出站邮件记录（可扩展为异步队列重试）
model EmailOutbox {
  id                    String    @id @default(cuid())
  userId                String?
  toAddress             String
  subject               String
  textBody              String
  status                String    @default("PENDING")
  errorMessage          String?
  relatedNotificationId String?
  createdAt             DateTime  @default(now())
  sentAt                DateTime?

  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  relatedNotification UserNotification? @relation(fields: [relatedNotificationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}
